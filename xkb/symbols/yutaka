partial alphanumeric_keys
xkb_symbols "basic" {

    include "ch(fr)"

    // D <-> E
    key <AD03> { [ d, D ] };
    key <AC03> { [ e, E ] };

    // U <-> K
    key <AD07> { [ k, K ] };
    key <AC08> { [ u, U ] };

    // P <-> L
    key <AD10> { [ l, L ] };
    key <AC09> { [ p, P ] };

    // Y <-> V
    key <AB01> { [ v, V ] };
    key <AB04> { [ y, Y ] };

    // G H <-> I O
    key <AD08> { [ g, G ] };
    key <AD09> { [ h, H ] };
    key <AC05> { [ i, I ] };
    key <AC06> { [ o, O ] };
};
